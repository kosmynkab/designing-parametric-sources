<aside class="reference-tree site-tree" open>
  <nav aria-label="Site navigation">
{#
    <details class="site-tree__section" open>
      <summary>Tutorials</summary>

      <ul class="site-tree__list">
        {% for item in collections.siteNavigation %}
          {% if item.data.navigation.section == "tutorials" %}
            <li>
              <a
                href="{{ item.url | url }}"
                {% if page.url == item.url %}aria-current="page"{% endif %}
              >
                {{ item.data.navigation.label }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </details>

    <details class="site-tree__section" open>
      <summary>How-to</summary>

      <ul class="site-tree__list">
        {% for item in collections.siteNavigation %}
          {% if item.data.navigation.section == "how-to" %}
            <li>
              <a
                href="{{ item.url | url }}"
                {% if page.url == item.url %}aria-current="page"{% endif %}
              >
                {{ item.data.navigation.label }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </details>
#}

    <details class="site-tree__section" open>
      <summary>Explanation</summary>

      <ul class="site-tree__list">
        {% for item in collections.siteNavigation %}
          {% if item.data.navigation.section == "explanation"
          and item.data.navigation.id != "explanation" %}
            <li>
              <a
                href="{{ item.url | url }}"
                {% if page.url == item.url %}aria-current="page"{% endif %}
              >
                {{ item.data.navigation.label }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </details>

    <details class="site-tree__section" open>
      <summary>Reference</summary>

      <a class="reference-tree__specimens" href="{{ '/reference/glossary/' | url }}">
        Glossary
      </a>
      <details class="reference-tree__section" open>
        <summary>Parametric axes</summary>

        <ul class="reference-tree__list">
          {% for parentAxis in referenceTree.parentAxes %}
            <li>
              <a
                href="{{ parentAxis.url | url }}"
                {% if page.url == parentAxis.url %}aria-current="page"{% endif %}
              >
                {{ parentAxis.tag }}
              </a>

              {% if parentAxis.childAxes.length %}
                <ul class="reference-tree__children">
                  {% for childAxis in parentAxis.childAxes %}
                    <li>
                      <a
                        href="{{ childAxis.url | url }}"
                        {% if page.url == childAxis.url %}aria-current="page"{% endif %}
                      >
                        {{ childAxis.tag }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}

          <li>
            <a
              href="{{ '/reference/axes/other/' | url }}"
              {% if page.url == '/reference/axes/other/' %}aria-current="page"{% endif %}
            >
              Other
            </a>

            <ul class="reference-tree__children">
              {% for axis in referenceTree.otherAxes %}
                <li>
                  <a
                    href="{{ axis.url | url }}"
                    {% if page.url == axis.url %}aria-current="page"{% endif %}
                  >
                    {{ axis.tag }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </li>
        </ul>
      </details>

      <a class="reference-tree__specimens" href="{{ '/reference/specimens/' | url }}">
        Specimen browser
      </a>
    </details>
  </nav>
</aside>
