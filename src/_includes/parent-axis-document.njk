{% set axis = parentAxes.byId[axisId] %}

<header class="site-header axis-header">
  <p class="eyebrow">Reference / Parent axis</p>
  <h1>{{ axis.tag }}</h1>
  <p>{{ axis.summary }}</p>
</header>

<div class="intro-content axis-page">
  {% for block in axis.blocks %}
    {% if block.type == "preamble" %}
      {{ block.html | safe }}
    {% else %}
      <section
        class="{% if block.id == 'expected-behaviour' %}axis-principle{% endif %}"
      >
        <h2>{{ block.title }}</h2>
        {{ block.html | safe }}
      </section>
    {% endif %}
  {% endfor %}
</div>