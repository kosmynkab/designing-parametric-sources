{% if not specimenStyle %}
  {% set specimenStyle = "roman" %}
{% endif %}

<div class="specimen-grid">
  {% for specimenInstance in ["min", "max"] %}
    {% for specimen in specimens.specimens %}
      {% if specimen.project == specimenProject
        and specimen.axis == specimenAxis
        and specimen.glyph == specimenGlyph
        and specimen.style == specimenStyle
        and specimen.instance == specimenInstance %}

        <figure class="specimen-card">
          <button class="specimen-zoom" type="button">
            <img
              src="{{ ('/' + specimen.image) | url }}"
              alt="{{ specimen.style | capitalize }} {{ specimen.glyph }} at {{ specimen.axis }} {{ specimen.instance }}"
            >
          </button>

          <figcaption>
            {{ specimen.glyph }} · {{ specimen.style | capitalize }} ·
            <a href="{{ ('/reference/child-axes/' ~ specimen.axis | lower ~ '/') | url }}">
              {{ specimen.axis }}
            </a>
            {{ specimen.instance }} · {{ specimen.source }}
          </figcaption>
        </figure>
      {% endif %}
    {% endfor %}
  {% endfor %}
</div>
