{% for group in axisSpecimens[axisId].groups %}
  <h3>{{ group.label }}</h3>
  <div class="specimen-grid">
    {% for specimen in group.specimens %}
      <figure class="specimen-card">
        {% set proofImageUrl = ("/" + specimen.image) | url %}
        {% set proofImageAlt = specimen.style | capitalize + " " + specimen.glyph + " at " + specimen.axis + " " + specimen.instance %}
        {% set proofLoading = "lazy" %}
        {% include "proof-viewer.njk" %}
        <figcaption>{{ specimen.glyph }} · {{ specimen.style }} · {{ specimen.axis }} {{ specimen.instance }}</figcaption>
      </figure>
    {% endfor %}
  </div>
{% endfor %}
