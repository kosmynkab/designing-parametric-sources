---
layout: base.njk
title: Proofing specimens

navigation:
  section: reference
  id: specimens
  label: Proofing specimens
  group: Amstelvar Avar2
  order: 10
---

<header class="site-header">
  <p class="eyebrow">Designing Parametric Sources</p>
  <h1>Proofing specimens</h1>
  <p>
    A first explorer for parametric axes, their parent-axis groupings,
    and representative glyphs.
  </p>
</header>

<section class="filters" aria-label="Filter specimens">
  
  <div class="filter-control">
    <label for="parent-axis-filter">Parent axis</label>

    <select id="parent-axis-filter">
      <option value="">All parent axes</option>
    </select>
    
  </div>  

  <div class="filter-control">
    <label for="axis-filter">Child axis</label>

    <select id="axis-filter">
      <option value="">All child axes</option>
    </select>
  </div>

  <div class="filter-control">
    <label for="glyph-group-filter">Glyph group</label>

    <select id="glyph-group-filter">
      <option value="">All glyph groups</option>
    </select>
  </div>

  <div class="filter-control">
    <label for="style-filter">Style</label>

    <select id="style-filter">
      <option value="">Roman and Italic</option>
    </select>
  </div>

</section>

<section class="specimen-grid" aria-label="Specimen images">
  {% for specimen in specimens.specimens %}
    <article
      class="specimen-card"
      data-parent-axis="{{ specimen.parent_axis or '' }}"
      data-axis="{{ specimen.axis }}"
      data-instance="{{ specimen.instance or '' }}"
      data-style="{{ specimen.style }}"
      data-group="{{ specimen.group }}"
      data-glyph="{{ specimen.glyph }}"
      data-tags="{{ specimen.tags | join(' ') }}"
    >
      <img
        src="{{ ("/" + specimen.image) | url }}"
        alt="{{ specimen.glyph }} — {{ specimen.style }}, {{ specimen.axis }}"
        loading="lazy"
      >
      <p>{{ specimen.glyph }} · {{ specimen.axis }}{{ specimen.instance }}</p>
    </article>
  {% endfor %}
</section>